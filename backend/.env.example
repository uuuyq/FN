DATABASE_URL=sqlite:///./data/fitplan.db
# Local HTTP development only. Production HTTPS must use true.
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:5173
# Model configuration: environment overrides the Git-ignored root config.yaml.
# The application does not automatically load this .env file.
# AI_API_KEY=your-private-key
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com
# AI_CONFIG_PATH=/absolute/path/to/config.yaml

# none / low / high / max. config.yaml uses reasoning_effort.
AI_REASONING_EFFORT=high
