DATABASE_URL=sqlite:///./data/fnote.db
# Local HTTP development only. Production HTTPS must use true.
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:5173
# Model credentials are configured per user in the application.
AI_CONTEXT_LIMIT=65536
# API Key encryption master key defaults to project runtime/secrets/ai-config.key.
# Keep it out of Git and back it up separately. Optional absolute path override:
# FNOTE_AI_KEY_FILE=/opt/fnote/runtime/secrets/ai-config.key
