{
  "name": "fitplan-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test ../tests/unit/",
    "test:e2e": "node ../tests/browser/calendar-flow.mjs && node ../tests/browser/agent-resilience.mjs",
    "test:e2e:core": "node ../tests/browser/calendar-flow.mjs",
    "test:e2e:resilience": "node ../tests/browser/agent-resilience.mjs"
  },
  "dependencies": {
    "antd": "5.29.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
